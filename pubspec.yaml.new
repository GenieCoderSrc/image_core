name: image_core
description: "A Dart/Flutter package for standardized image and file upload handling using SOLID principles. 
  Supports cross-platform file conversion from XFile, File, and PlatformFile to a unified UploadFile model, 
  file type categorization, and abstract upload/delete management via BaseImageManager."

version: 0.0.8

homepage: https://github.com/GenieCoderSrc/image_core
repository: https://github.com/GenieCoderSrc/image_core
issue_tracker: https://github.com/GenieCoderSrc/image_core/issues



environment:
  sdk: \x27>=3.6.0 <4.0.0\x27

    flutter: ">=3.0.0"
